{
  "manifest_version": 3,
  "name": "Currio",
  "version": "1.0.0",
  "description": "Auto currency converter — recognize and convert money amounts on any page",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.exchangerate-api.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["src/utils.js", "src/content.js"],
    "css": ["src/content.css"]
  }],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Currio"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
